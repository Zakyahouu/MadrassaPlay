{
  "settings": {
    "title": {
      "type": "text",
      "label": "Title",
      "required": true,
      "default": "My Quiz"
    },
    "timePerQuestion": {
      "type": "number",
      "label": "Time per question (seconds)",
      "required": false,
      "default": 0
    },
    "passingScore": {
      "type": "number",
      "label": "Passing score (correct answers)",
      "required": false,
      "default": 0
    }
  },
  "content": {
    "label": "Questions",
    "minItems": 1,
    "itemSchema": {
      "question": {
        "type": "text",
        "label": "Question",
        "required": true
      },
      "options": {
        "type": "text",
        "label": "Options (comma-separated)",
        "required": true
      },
      "correctOptionIndex": {
        "type": "number",
        "label": "Correct Option Index (0-based)",
        "required": true
      }
    }
  }
}
